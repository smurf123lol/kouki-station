menu "Kouki Station"

    menu "Wi-Fi"

        config KOUKI_WIFI_TIMEOUT_S
            int "Сколько секунд ждать подключения"
            default 25
            range 5 120

    endmenu

    menu "Динамик и озвучивание"

        config KOUKI_PLAYER_PA_GPIO
            int "GPIO усилителя динамика"
            range -1 48
            default 15
            help
                NS4150B на этой плате включается высоким уровнем на GPIO 15
                (заводской пример Waveshare). В вендорном audio_board нога
                отключена (GPIO_PWR_CTRL = -1), поэтому усилитель надо поднимать
                самим: иначе кодек принимает данные, а динамик молчит.

                Если на вашей ревизии платы усилитель подключён иначе или
                включён всегда — поставьте -1, и станция не будет трогать пин.

        config KOUKI_PLAYER_VOLUME
            int "Громкость воспроизведения, %"
            range 0 100
            default 80
            help
                Ставится после открытия кодека: в bsp_board.c громкость
                выставляется до esp_codec_dev_open, а ES8311 такой вызов
                игнорирует — выход остаётся на нуле.

                Это громкость кодека, не амплитуда сигналов
                (у сигналов своя — KOUKI_SIGNAL_VOLUME).

        config KOUKI_SPEECH_ENABLED
            bool "Озвучивать ответ станции"
            default y
            help
                После ответа на «Спросить» станция забирает WAV из
                POST /api/speech и играет его через тот же кодек, что и
                звуковые сигналы. Ответ на экране не задерживается.

                Требует сети до сервера и включённого синтеза на сервере
                (без sherpa /api/speech отвечает 503 — станция просто
                промолчит и напишет причину в лог).

        config KOUKI_SILENT_MODE
            bool "Режим тишины по умолчанию (без речи)"
            default n
            help
                При включении станция выводит ответы только на дисплей,
                не запрашивая /api/speech и не задействуя динамик.
                Значение можно переопределить через NVS-параметр 'silent'
                или команду консоли 'set_silent <0|1>'.

    endmenu

    menu "Wake-word"

        config KOUKI_WAKE_ENABLED
            bool "Слушать кодовое слово в простое"
            default n
            help
                Пока станция ничего не записывает, поток с микрофона идёт
                в детектор esp-sr. Услышали слово — начинаем запись без касания.
                Кнопки остаются рабочим путём: детектор может промолчать.

                По умолчанию ВЫКЛЮЧЕНО: детектору нужна модель в отдельной
                flash-партиции (~1 МБ) и подобранный порог, а без модели он
                просто не поднимется и станция останется на кнопках.
                Чтобы включить:
                  1) в sdkconfig.defaults (или sdkconfig.secret) добавить
                     CONFIG_SR_WN_WN10_HIESP=y и CONFIG_MODEL_IN_FLASH=y;
                  2) здесь поставить y и, если нужно, имя модели;
                  3) прошивать вместе с srmodels.bin (tools/flash-windows.ps1).

        config KOUKI_WAKE_MODEL
            depends on KOUKI_WAKE_ENABLED
            string "Имя модели (пусто — первая найденная)"
            default ""
            help
                Например wn10_hiesp или wn9_hilexin. Пустая строка — берём
                первую wake-word модель из esp-sr.

        config KOUKI_WAKE_PARTITION
            depends on KOUKI_WAKE_ENABLED
            string "Партиция с моделями esp-sr"
            default "model"
            help
                esp-sr читает модели из flash-раздела, а не из образа приложения.
                Метка должна совпадать с partitions.csv, иначе детектор не поднимется
                и станция останется работать только по кнопке.

        config KOUKI_WAKE_THRESHOLD
            depends on KOUKI_WAKE_ENABLED
            int "Порог срабатывания, проценты"
            default 65
            range 10 95
            help
                Ниже — ловит чаще и врёт чаще; выше — стабильнее, но человеку
                приходится говорить громче. Настраивается по месту.

        config KOUKI_WAKE_VERIFY
            bool "Эксперимент: подтверждать хит распознаванием на сервере"
            default n
            help
                Выключено по умолчанию: отмена после уже прошедшего wake
                («бип есть, записи нет») хуже ложного срабатывания и вдобавок
                зависит от сети и ASR. Ложные срабатывания лечим детектором
                (переобучение на hard-negatives, T112) и серверным отсевом
                шумовых транскриптов, а не отменой записи на лету.
                Опция оставлена только для экспериментов: при включении станция
                после локального хита отправляет начало записи на
                POST /api/transcribe и сверяет текст с «эй гин»; если сервер
                недоступен, доверяем локальному хиту.

        config KOUKI_WAKE_VERIFY_TIMEOUT_MS
            depends on KOUKI_WAKE_VERIFY
            int "Таймаут ASR-подтверждения, мс"
            default 4000
            range 500 10000
            help
                Сколько ждём ответ /api/transcribe. Дольше — запись продолжается
                без проверки.

        config KOUKI_WAKE_RECORD_S
            depends on KOUKI_WAKE_ENABLED
            int "Сколько секунд писать после кодового слова"
            default 6
            range 2 15
            help
                Запись запускается сама и сама останавливается: цепочка
                «проснулись → сказали → ушло на сервер» без касания экрана.

    endmenu

    menu "Запись"

        config KOUKI_MIN_AMPLITUDE
            int "Минимальная средняя амплитуда записи"
            range 0 3000
            default 120
            help
                Средняя абсолютная амплитуда PCM16, ниже которой запись считается тишиной
                и не отправляется на сервер. На тишине распознаватель выдаёт галлюцинации
                вроде «(звук пилот)», и они попадают в задачи. Ориентир: фон комнаты
                30–80, человек в полуметре после усиления — 800–2500.

        config KOUKI_MAX_RECORD_S
            int "Максимальная длительность записи, секунд"
            default 15
            range 2 60
            help
                Буфер под запись выделяется сразу под этот максимум:
                KOUKI_MAX_RECORD_S × 16000 × 2 байта (15 с ≈ 480 КБ в PSRAM).

        config KOUKI_MIC_CHANNEL
            int "Канал микрофона в потоке ES7210 (0..3)"
            default 1
            range 0 3
            help
                BSP отдаёт четыре канала; в bsp_get_feed_data микрофоны — это
                индексы 1 и 3, индекс 0 — опорный сигнал эхоподавления.
                По умолчанию берём первый микрофон (индекс 1).

        config KOUKI_FOLLOWUP_WINDOW_MS
            int "Окно ожидания продолжения диалога после ответа, мс"
            default 6000
            range 0 30000
            help
                Сколько миллисекунд после озвучивания ответа станция слушает фразу
                продолжения без нажатия кнопки и без кодового слова («гин»).
                0 — окно выключено (станция сразу переходит в IDLE).

        config KOUKI_FOLLOWUP_SILENCE_MS
            int "Тишина, завершающая запись продолжения, мс"
            default 1200
            range 500 5000
            help
                Сколько миллисекунд подряд тишины закрывает запись продолжения
                внутри окна диалога и запускает отправку на сервер.

        config KOUKI_FOLLOWUP_MIN_VOICED_MS
            int "Минимум подтверждённой речи в продолжении, мс"
            default 500
            range 0 3000
            help
                Кусок считаем речью, только если VAD подтвердил её суммарно
                хотя бы столько. Иначе запись отбрасывается локально и не
                уходит на сервер (телевизор и фоновый шум часто дают
                «речь» на 100–200 мс).

        config KOUKI_FOLLOWUP_TASK_ENABLED
            bool "Открывать follow-up окно после записи задачи"
            default n
            help
                По умолчанию выключено: станция сразу возвращается в покой
                после записи обычной задачи. Включение оставляет окно продолжения
                диалога открытым и после записи задач.

    endmenu

    menu "Звуковые сигналы"

        config KOUKI_SOUND_SIGNALS
            bool "Короткие тоны на события"
            default y
            help
                Станция подтверждает звуком старт записи, завершение и отправку,
                ошибку сети и срабатывание кодового слова. Тоны синтезируются
                процедурно в RAM (16 кГц, PCM16); синтез моно, на кодек уходит
                стереопара L=R, потому что воспроизведение открыто в стерео.
                Файлов на flash нет.

                По умолчанию включено. Выключите, если сигналы мешают: запись,
                отправка и экран продолжат работать как раньше.

        config KOUKI_SIGNAL_VOLUME
            depends on KOUKI_SOUND_SIGNALS
            int "Громкость сигналов, проценты"
            default 50
            range 0 100
            help
                Амплитуда синтеза относительно полной шкалы: 0 — тишина,
                100 — максимум. По умолчанию 50 — отчётливо слышно, но не
                громче ответа ассистента.

                Это амплитуда синтеза, а не громкость кодека: громкость выхода
                задаёт KOUKI_PLAYER_VOLUME в разделе «Динамик», поэтому сигналы
                и речь звучат с одного уровня.

    endmenu

    menu "Тестовый режим"

        config KOUKI_TEST_MODE
            bool "Проверять тракт при загрузке без человека"
            default n
            help
                После подключения к сети станция сама записывает несколько секунд
                и отправляет их на сервер. Нужен, чтобы проверить тракт без нажатия
                кнопки: слышен ли микрофон, проходит ли запрос, что отвечает сервер.
                В обычной прошивке выключен — иначе станция отправит лишнюю фразу
                при каждом включении.

        config KOUKI_TEST_MODE_DELAY_S
            int "Пауза после подключения к сети, с"
            default 5
            range 0 120
            depends on KOUKI_TEST_MODE
            help
                Время, за которое можно успеть сказать фразу в микрофон.

        config KOUKI_TEST_MODE_SECONDS
            int "Сколько секунд писать в тестовом режиме"
            default 5
            range 1 15
            depends on KOUKI_TEST_MODE

        choice KOUKI_TEST_MODE_SESSION
            prompt "С чем отправить тестовую запись"
            default KOUKI_TEST_MODE_AS_TASK
            depends on KOUKI_TEST_MODE

            config KOUKI_TEST_MODE_AS_TASK
                bool "Как задачу (intent=add_task)"

            config KOUKI_TEST_MODE_AS_QUESTION
                bool "Как вопрос (intent=ask)"

        endchoice

        config KOUKI_TEST_CONSOLE_CMDS
            bool "Тестовые команды консоли (только для отладки/симулятора)"
            default n
            help
                Включает отладочные консольные команды test_seed_history и
                test_mock_done для проверки истории и экрана ответа в симуляторе
                без сервера. В обычной прошивке должно быть выключено (n).

        config KOUKI_SIM_MIC
            bool "Sim-микрофон для esp32sim (только для стенда)"
            default n
            help
                sim-only путь микрофона для esp32sim: I2S RX отдаёт стерео, BSP
                размножает его в 4-канальный RMNM-порядок; на плате должно быть n.

    endmenu

    menu "Сервер и безопасность (TLS)"

        config KOUKI_SERVER_URL
            string "URL сервера по умолчанию"
            default "https://kouki.local"
            help
                URL сервера Kouki (https://kouki.local). После настройки через SoftAP-портал
                перекрывается значением из NVS (srv_url).

        config KOUKI_ALLOW_HTTP
            bool "Разрешить незащищённый HTTP (отладка)"
            default n
            help
                По умолчанию ВЫКЛЮЧЕНО: станция требует https:// и проверяет pinned CA.
                Включение разрешает http:// для стендов и локальной отладки.

        config KOUKI_TLS_TIMEOUT_S
            int "Таймаут TLS handshake, секунд"
            default 10
            range 2 60
            help
                Максимальное время на установку TLS-соединения с сервером.

    endmenu

endmenu

config KOUKI_DEBUG_MIC
    bool "Печатать уровни каналов микрофона при старте"
    default n
    help
        Одноразовая диагностика: при загрузке печатает среднюю амплитуду
        каждого канала входа (raw и обработанные). Нужна, когда станция
        «не слышит»: видно, есть ли сигнал и на каком канале.

config KOUKI_MIC_GAIN
    int "Усиление микрофона (разы)"
    range 1 32
    default 6
    help
        Микрофоны платы отдают тихий сигнал: средняя амплитуда речи без
        усиления — десятки единиц. Усиление в цифре поднимает и запись, и
        детектор кодового слова. 6 — разумная середина; 12 — если диктуют
        издалека и слышно плохо.
