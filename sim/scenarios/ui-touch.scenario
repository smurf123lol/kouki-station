# ui-touch — переход по плиткам касанием и интерактив экрана настроек.
#
# Что проверяем: свайп с главного экрана на «Настройки», переключатель
# wake-word и слайдер громкости реально меняют конфигурацию (по логам
# main/ui/states/ui_settings_tile.cpp), а не просто рисуют картинку.
# Прогон сознательно заканчивается НА экране настроек: screen.png в артефактах
# тогда показывает именно его, и это видно человеку без запуска.
max-seconds: 9

# Наполняем историю: карточки на плитке истории должны быть не пусты.
4.00 serial test_seed_history
# Свайп вправо-влево по плиткам: с голосовой (центр) на настройки.
4.60 touch 320 180 1
4.62 touch 260 180 1
4.64 touch 200 180 1
4.66 touch 130 180 1
4.68 touch 70 180 1
4.70 touch 40 180 1
4.72 touch 40 180 0
# Тумблер «Активация «эй гин»».
5.40 touch 283 127 1
5.50 touch 283 127 0
# Слайдер громкости: три положения подряд.
6.00 touch 250 82 1
6.10 touch 200 82 1
6.20 touch 150 82 1
6.30 touch 150 82 0
# Тап по версии/пустому месту — проверка, что тап вне контролов ничего не ломает.
6.90 touch 180 300 1
7.00 touch 180 300 0
7.60 stop

expect:
# main/ui/ui_state_manager.cpp:183 — UI из трёх плиток поднялся.
+ UI State Machine инициализирована успешно (3 плитки)
# main/app_setup.c — история наполнилась (10 записей).
+ Добавлена запись в историю
# main/ui/states/ui_settings_tile.cpp:52 — тумблер отработал.
+ wake-word переключен: вкл
# main/ui/states/ui_settings_tile.cpp:39 — слайдер отработал.
+ громкость изменена:
# Ничего из этого в рабочем прогоне быть не должно.
- Guru Meditation
- abort()
- assert failed
