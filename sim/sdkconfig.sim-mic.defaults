# Sim-сборка стенда esp32sim с подменой микрофона (T120, П3).
# Подключается флагом tools/build-linux.sh --sim-mic; в боевую сборку не входит.
#
# Флаг KOUKI_SIM_MIC (firmware/main/Kconfig.projbuild) включает sim-путь вместо
# записи с реального ES7210: сэмплы приходят из I2S RX, куда эмулятор подаёт
# WAV действием `i2s_wav`. Нужен сценариям с голосом: wake, wake-false-positive,
# followup. Без этого флага эмулятор молчит в микрофон, прошивка пишет
# «read_mic(56): чтение микрофона не удалось», и голосовые сценарии падают.
CONFIG_KOUKI_SIM_MIC=y
